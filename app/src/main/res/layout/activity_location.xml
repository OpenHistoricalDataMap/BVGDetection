<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <RelativeLayout
        android:id="@+id/buttons_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp">

        <ImageButton
            android:id="@+id/locate_1s_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/locate_button_description" />

    </RelativeLayout>


    <ProgressBar
        android:id="@+id/location_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/buttons_layout"
        android:indeterminate="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:progress="0" />


    <View
        android:id="@+id/separator_view_location"
        android:layout_width="fill_parent"
        android:layout_height="2dp"
        android:layout_below="@+id/location_progressbar"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:background="#7A7A7A" />

    <LinearLayout
        android:id="@+id/initial_wifi_label_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/separator_view_location"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/initial_wifi_label_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/initial_wifi_textview"
            android:text="@string/initial_wifi_name"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifi_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/locattion_settings_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/initial_wifi_label_layout"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/locattion_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:labelFor="@+id/initial_locattion_settings_textview"
            android:text="Algorithmus EInstellungen:"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/locattion_settings_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>


    <RelativeLayout
        android:id="@+id/result_node_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/locattion_settings_layout"
        android:layout_marginTop="5dp">

        <TextView
            android:id="@+id/location_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:text="@string/measured_node_textview_text"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="@color/colorAccent" />

        <TextView
            android:id="@+id/description_textview_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/location_textview"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp" />

        <ImageView
            android:id="@+id/location_imageview"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_below="@+id/description_textview_location"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="15dp"
            android:contentDescription="@string/image_placeholder" />

    </RelativeLayout>


    <TextView
        android:id="@+id/infobox_location"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/info_box"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:text="@string/location_infobox_text" />

</RelativeLayout>
